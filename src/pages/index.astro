---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import AbsoluteTouchCard from '../components/AbsoluteTouchCard.astro';
import MarqueeSection from '../components/MarqueeSection.astro';
import WritingVideoSection from '../components/WritingVideoSection.astro';
import TechSpecsSection from '../components/TechSpecsSection.astro';
---

<Layout>
    <!-- Barra de Progresso Global na Borda Inferior -->
    <div class="global-scrub-bar fixed bottom-0 left-0 w-full h-[2px] bg-stone-300/40 z-50 pointer-events-none"
        aria-hidden="true">
        <div class="h-full w-0 bg-stone-900 transition-all duration-75" id="globalScrubFill"></div>
    </div>

    <!-- MAIN HERO (SCRUB TRACK + PALCO PINNED) -->
    <main class="hero-scrub-track relative" id="heroTrack">
        <section class="hero-stage flex items-center justify-center bg-[#EAEAE5]" id="heroStage"
            aria-label="Apresentação Interativa da Caneta ARTOOLS">

            <!-- Fundo Visual 100% Tela: Vídeo Nativo de Alta Fidelidade (Modelo video2.mp4) + Fallback Canvas -->
            <div class="absolute inset-0 w-full h-full pointer-events-none overflow-hidden z-0"
                id="visualContainer">
                <!-- Primário: Canvas Sequence (Padrão Apple - 60/120fps fluido) -->
                <canvas id="heroCanvas" class="hero-canvas" aria-label="Caneta ARTOOLS animada no canvas"></canvas>

                <!-- Motor Primário: Vídeo Nativo MP4 em Tela Cheia no Fundo do Hero -->
                <video id="heroVideo" class="hero-video" tabindex="-1" muted playsinline webkit-playsinline
                    preload="auto" src="/assets/videos/video2.mp4" aria-label="Vídeo coreografado da caneta ARTOOLS">
                    <source src="/assets/videos/video2.mp4" type="video/mp4">
                    <source src="/assets/raw_files/video2.mp4" type="video/mp4">
                    <source src="/video2.mp4" type="video/mp4">
                </video>
            </div>

            <!-- Palco em Primeiro Plano: Layout Exato da Referência Visual -->
            <div
                class="relative w-full max-w-[1440px] mx-auto h-full px-6 md:px-12 pt-20 pb-8 flex items-center justify-between z-20 pointer-events-none">

                <!-- Coluna Esquerda: Headline, Descrição e Botões -->
                <div class="w-full max-w-xl flex flex-col justify-center pointer-events-auto z-20"
                    id="heroLeftContent">

                    <!-- Headline Exata da Referência: "A caneta mais tecnológica do mundo." -->
                    <h1 class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-[5.5rem] font-bold tracking-tight leading-[0.92] mb-6 text-stone-900 flex flex-col items-start"
                        id="heroHeadline">
                        <span class="text-reveal-wrapper">
                            <span class="text-reveal-content">A caneta</span>
                        </span>
                        <span class="text-reveal-wrapper">
                            <span class="text-reveal-content delay-200 text-outline">mais tecnológica</span>
                        </span>
                        <span class="text-reveal-wrapper">
                            <span class="text-reveal-content delay-300">do mundo.</span>
                        </span>
                    </h1>

                    <!-- Texto de Apoio Exato da Referência -->
                    <p class="text-sm sm:text-base md:text-lg text-stone-600 max-w-lg leading-relaxed font-normal mb-8 text-balance"
                        id="heroDescription">
                        A Artools Precision Pen redefine o equilíbrio entre peso, fluxo e design. Feita para criadores que exigem perfeição em cada traço.
                    </p>

                    <!-- Botões de Ação no Padrão do Design System (Quadrados) -->
                    <div class="flex flex-wrap items-center gap-3.5" id="ctaGroup">
                        <a href="#buy" id="btnHeroBuy"
                            class="bg-stone-900 text-white px-7 py-3 rounded-none font-mono text-xs uppercase tracking-widest flex items-center justify-center gap-2 hover:bg-stone-800 transition-all cursor-pointer shadow-none">
                            <span>Comprar Agora</span>
                        </a>

                        <a href="#architectureSection" id="btnHeroExplore"
                            class="bg-white/90 border border-stone-300 text-stone-900 px-7 py-3 rounded-none font-mono text-xs uppercase tracking-widest flex items-center justify-center gap-2 hover:bg-white hover:border-stone-400 transition-all cursor-pointer shadow-none">
                            <span>Explorar ↓</span>
                        </a>
                    </div>
                </div>

            </div>

            <!-- Indicador Lateral 01 (Lado Direito da Tela como na referência) -->
            <div class="hidden md:flex absolute right-8 lg:right-12 top-1/2 -translate-y-1/2 flex-col items-center gap-3 font-mono text-[11px] text-stone-400 pointer-events-none z-30">
                <span class="font-medium text-stone-600">01</span>
                <div class="w-px h-12 bg-stone-300"></div>
            </div>

            <!-- Indicador Inferior Central (Referência: SCROLL TO CONTROL) -->
            <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 pointer-events-auto z-30"
                id="scrollHint">
                <span class="font-mono text-[10px] tracking-[0.25em] uppercase text-stone-400">SCROLL TO CONTROL</span>
                <div class="w-px h-6 bg-stone-300 relative overflow-hidden">
                    <div class="w-full h-full bg-stone-900 animate-scroll-line"></div>
                </div>
            </div>

        </section>
    </main>

    <!-- ==========================================================================
       MARQUEE TÉCNICO CONTÍNUO (AURA DESIGN SYSTEM)
       ========================================================================== -->
    <div class="relative w-full border-y border-stone-300/80 bg-stone-200/60 py-3 overflow-hidden z-20">
        <div
            class="animate-marquee whitespace-nowrap flex items-center gap-12 font-mono text-xs uppercase tracking-[0.22em] text-stone-600">
            <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-stone-900"></span> CALIBRE
                NOMINAL 0.1 MM</span>
            <span class="text-stone-400">/</span>
            <span>USINAGEM SUÍÇA 5-EIXOS (TOLERÂNCIA ±0.002 MM)</span>
            <span class="text-stone-400">/</span>
            <span>MICROESFERA CARBETO DE TUNGSTÊNIO 9.5 MOHS</span>
            <span class="text-stone-400">/</span>
            <span>NANO-PIGMENTO CARBON BLACK FÓSSIL</span>
            <span class="text-stone-400">/</span>
            <span>SECAGEM INSTANTÂNEA 0.8S ANTI-BORRÃO</span>
            <span class="text-stone-400">/</span>
            <span>100 ANOS DE ESTABILIDADE ARQUIVÍSTICA ISO 14145-2</span>
            <span class="text-stone-400">/</span>
            <span>CHASSI MONOBLOCO 11.8G EM POLÍMERO AEROESPACIAL</span>
            <span class="text-stone-400">/</span>
            <span>CENTRO DE GRAVIDADE BARICÊNTRICO ZERO-FADIGA</span>
            <span class="text-stone-400">/</span>
            <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-stone-900"></span> CALIBRE
                NOMINAL 0.1 MM</span>
            <span class="text-stone-400">/</span>
            <span>USINAGEM SUÍÇA 5-EIXOS (TOLERÂNCIA ±0.002 MM)</span>
            <span class="text-stone-400">/</span>
            <span>MICROESFERA CARBETO DE TUNGSTÊNIO 9.5 MOHS</span>
            <span class="text-stone-400">/</span>
            <span>NANO-PIGMENTO CARBON BLACK FÓSSIL</span>
            <span class="text-stone-400">/</span>
            <span>SECAGEM INSTANTÂNEA 0.8S ANTI-BORRÃO</span>
            <span class="text-stone-400">/</span>
            <span>100 ANOS DE ESTABILIDADE ARQUIVÍSTICA ISO 14145-2</span>
            <span class="text-stone-400">/</span>
            <span>CHASSI MONOBLOCO 11.8G EM POLÍMERO AEROESPACIAL</span>
            <span class="text-stone-400">/</span>
            <span>CENTRO DE GRAVIDADE BARICÊNTRICO ZERO-FADIGA</span>
        </div>
    </div>

    <!-- ==========================================================================
       SEÇÃO 02: ARQUITETURA MECATRÔNICA & ENGENHARIA DE MATERIAIS
       (Dobra 02: Centralizada // Fundo escuro idêntico ao card #141416)
       ========================================================================== -->
    <section id="architectureSection"
        class="relative z-20 w-full bg-white text-stone-900 border-b border-stone-200 py-12 md:py-16 px-6 md:px-12 overflow-hidden"
        aria-label="Engenharia e Arquitetura do Produto">

        <!-- Architectural Grid Lines (Aura Design System - Light Mode) -->
        <div class="max-w-[1440px] mx-auto pointer-events-none absolute inset-0 z-0 grid grid-cols-1 md:grid-cols-12 gap-0 h-full w-full opacity-35"
            aria-hidden="true">
            <div class="hidden md:block md:col-span-1 border-r border-stone-200 h-full"></div>
            <div class="hidden md:block md:col-span-1 border-r border-stone-200 h-full"></div>
            <div class="hidden md:block md:col-span-1 border-r border-stone-200 h-full"></div>
            <div class="hidden md:block md:col-span-1 border-r border-stone-200 h-full"></div>
            <div class="hidden md:block md:col-span-1 border-r border-stone-200 h-full"></div>
            <div class="hidden md:block md:col-span-1 border-r border-stone-200 h-full"></div>
            <div class="hidden md:block md:col-span-1 border-r border-stone-200 h-full"></div>
            <div class="hidden md:block md:col-span-1 border-r border-stone-200 h-full"></div>
            <div class="hidden md:block md:col-span-1 border-r border-stone-200 h-full"></div>
            <div class="hidden md:block md:col-span-1 border-r border-stone-200 h-full"></div>
            <div class="hidden md:block md:col-span-1 border-r border-stone-200 h-full"></div>
        </div>

        <!-- Marca d'Água Tipográfica Arquitetônica Gigante (Aura DS - Light) -->
        <div
            class="absolute -bottom-8 left-0 w-full overflow-hidden pointer-events-none select-none opacity-[0.03] leading-none text-[16vw] font-display font-black text-stone-900 whitespace-nowrap z-0">
            PRECISION // 0.1MM
        </div>

        <!-- Floating Ambient Luminous Orbs Sutis -->
        <div
            class="absolute top-[15%] right-[-5%] w-[450px] h-[450px] bg-gradient-to-br from-stone-200/40 to-transparent rounded-full blur-3xl pointer-events-none opacity-50 animate-float">
        </div>
        <div class="absolute bottom-[5%] left-[-5%] w-[400px] h-[400px] bg-gradient-to-tr from-emerald-500/5 to-transparent rounded-full blur-3xl pointer-events-none opacity-40 animate-float"
            style="animation-delay: -3s;"></div>

        <div class="max-w-[1440px] mx-auto relative z-10 flex flex-col items-center">

            <!-- Cabeçalho Editorial Centralizado da Dobra 02 -->
            <div class="mb-8 md:mb-12 max-w-3xl mx-auto text-center flex flex-col items-center arch-header-reveal">
                <!-- Eyebrow Pill Light -->
                <div
                    class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-stone-300 bg-stone-100/90 backdrop-blur-md mb-3.5 shadow-xs">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="text-[11px] font-mono uppercase tracking-[0.2em] text-stone-600 font-medium">ENGENHARIA MECATRÔNICA // CALIBRAÇÃO SUÍÇA</span>
                </div>

                <!-- Headline Impactante Centralizada -->
                <h2
                    class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tighter text-stone-900 leading-[0.98] mb-3.5">
                    Arquitetura de Precisão
                </h2>

                <!-- Subtitle Centralizado -->
                <p class="font-sans text-sm md:text-base text-stone-600 leading-relaxed font-light text-balance text-center max-w-2xl">
                    Tolerância micrométrica de nível aeroespacial, calibração suíça de cinco eixos e pigmentação molecular permanente. Cada componente usinado para eliminar todo atrito com o papel.
                </p>
            </div>

            <!-- Grid de 2 Colunas: Imagem Menor à Esquerda + 3 Tópicos Diretos à Direita -->
            <div class="w-full max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">

                <!-- Coluna Esquerda: Imagem da Caneta Menor e Localizada à Esquerda -->
                <div class="lg:col-span-6 flex flex-col arch-visual-card-wrap">
                    <div class="relative w-full rounded-2xl bg-[#141416] border border-stone-300 shadow-xl p-3.5 sm:p-4 overflow-hidden group"
                        id="schematicCard">

                        <!-- Grid Técnico de Fundo / Blueprint Sutil -->
                        <div class="absolute inset-0 bg-grid opacity-15 pointer-events-none"
                            style="background-size: 24px 24px; background-image: linear-gradient(to right, rgba(255,255,255,0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.08) 1px, transparent 1px);">
                        </div>

                        <!-- Barra Superior: Status + Seletor de Vistas -->
                        <div
                            class="flex flex-wrap items-center justify-between border-b border-white/10 pb-2.5 mb-3 relative z-10 gap-2 font-mono text-[10px] sm:text-[11px] uppercase tracking-widest text-stone-400">
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                                <span class="text-stone-200">SISTEMA ATIVO // 0.1 MM</span>
                            </div>

                            <!-- Seletor Interativo de Vistas -->
                            <div class="flex items-center gap-1 p-0.5 bg-white/5 rounded-lg border border-white/10"
                                id="viewTabsGroup">
                                <button type="button"
                                    class="view-tab-btn active px-2 py-0.5 rounded text-[10px] font-mono uppercase tracking-wider text-white bg-stone-800 transition-all cursor-pointer"
                                    data-img="/assets/images/pen_architecture_dark.jpg" data-mode="studio">01 • Estúdio</button>
                                <button type="button"
                                    class="view-tab-btn px-2 py-0.5 rounded text-[10px] font-mono uppercase tracking-wider text-stone-400 hover:text-white transition-all cursor-pointer"
                                    data-img="/assets/images/pen_architecture_uncapped.jpg" data-mode="tip">02 • Ponta</button>
                                <button type="button"
                                    class="view-tab-btn px-2 py-0.5 rounded text-[10px] font-mono uppercase tracking-wider text-stone-400 hover:text-white transition-all cursor-pointer"
                                    data-img="/assets/images/pen_real_photo.jpg" data-mode="real">03 • Foto Real</button>
                            </div>
                        </div>

                        <!-- Palco Principal: Foto da Caneta em Proporção Focada e Menor -->
                        <div class="relative w-full aspect-[4/3] rounded-xl overflow-hidden bg-stone-950 flex items-center justify-center border border-white/10 shadow-inner"
                            id="schematicStage">

                            <img src="/assets/images/pen_architecture_dark.jpg"
                                alt="ARTOOLS Pigmentum 0.1 em corte mecatrônico de precisão"
                                class="absolute inset-0 w-full h-full object-cover object-center scale-100 transition-all duration-700 ease-out group-hover:scale-105 opacity-90"
                                id="schematicPenImg" />

                            <!-- Vinhetas Gradientes -->
                            <div
                                class="absolute inset-0 bg-gradient-to-t from-[#141416]/90 via-transparent to-[#141416]/30 pointer-events-none">
                            </div>

                            <!-- SVG de Conexão Neural / Linhas de Precisão -->
                            <svg class="absolute inset-0 w-full h-full pointer-events-none z-10" viewBox="0 0 600 450"
                                preserveAspectRatio="none">
                                <defs>
                                    <linearGradient id="lineGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="rgba(255,255,255,0.4)" />
                                        <stop offset="100%" stop-color="rgba(255,255,255,0.05)" />
                                    </linearGradient>
                                </defs>
                                <line x1="300" y1="225" x2="130" y2="100" stroke="url(#lineGrad)" stroke-width="1.5"
                                    stroke-dasharray="4,4" class="circuit-line" />
                                <line x1="300" y1="225" x2="470" y2="110" stroke="url(#lineGrad)" stroke-width="1.5"
                                    stroke-dasharray="4,4" class="circuit-line" />
                                <line x1="300" y1="225" x2="470" y2="350" stroke="url(#lineGrad)" stroke-width="1.5"
                                    stroke-dasharray="4,4" class="circuit-line" />
                                <line x1="300" y1="225" x2="130" y2="340" stroke="url(#lineGrad)" stroke-width="1.5"
                                    stroke-dasharray="4,4" class="circuit-line" />

                                <circle cx="300" cy="225" r="32" fill="none" stroke="rgba(255,255,255,0.2)"
                                    stroke-width="1" class="animate-ping" style="animation-duration: 3s;" />
                            </svg>

                            <!-- Hub Central -->
                            <div
                                class="absolute z-20 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center justify-center">
                                <div
                                    class="w-10 h-10 rounded-full bg-stone-900/90 border border-white/30 backdrop-blur-md flex items-center justify-center text-white shadow-lg relative cursor-pointer group/hub transition-transform hover:scale-110">
                                    <iconify-icon icon="solar:pen-bold-duotone"
                                        class="text-lg text-white"></iconify-icon>
                                    <span
                                        class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 bg-emerald-400 border-2 border-stone-950 rounded-full animate-pulse"></span>
                                </div>
                            </div>

                            <!-- Nós Interativos -->
                            <button type="button"
                                class="node-btn absolute z-20 top-[12%] left-[6%] p-1.5 px-2.5 rounded-lg bg-stone-900/85 border border-white/20 hover:border-white/70 backdrop-blur-md text-white flex items-center gap-1.5 text-xs font-mono transition-all hover:scale-105 group/node shadow-none cursor-pointer"
                                data-id="1" data-name="MICROESFERA EM CARBETO DE TUNGSTÊNIO"
                                data-spec="USINAGEM SUÍÇA 5-EIXOS // TOLERÂNCIA ±0.002 MM">
                                <iconify-icon icon="solar:target-bold-duotone" class="text-xs text-stone-300"></iconify-icon>
                                <span class="font-sans font-medium text-[10px] text-stone-200">Ponta 0.1 mm</span>
                            </button>

                            <button type="button"
                                class="node-btn absolute z-20 top-[14%] right-[6%] p-1.5 px-2.5 rounded-lg bg-stone-900/85 border border-white/20 hover:border-white/70 backdrop-blur-md text-white flex items-center gap-1.5 text-xs font-mono transition-all hover:scale-105 group/node shadow-none cursor-pointer"
                                data-id="2" data-name="REGULADOR ISOMÉTRICO DE VÁCUO"
                                data-spec="FLUXO LAMINAR CONSTANTE ANTI-VAZAMENTO">
                                <iconify-icon icon="solar:tuning-square-2-bold-duotone" class="text-xs text-stone-300"></iconify-icon>
                                <span class="font-sans font-medium text-[10px] text-stone-200">Válvula Isométrica</span>
                            </button>

                            <button type="button"
                                class="node-btn absolute z-20 bottom-[14%] right-[6%] p-1.5 px-2.5 rounded-lg bg-stone-900/85 border border-white/20 hover:border-white/70 backdrop-blur-md text-white flex items-center gap-1.5 text-xs font-mono transition-all hover:scale-105 group/node shadow-none cursor-pointer"
                                data-id="2" data-name="FÓRMULA NANO-PIGMENTADA CARBON BLACK"
                                data-spec="SECAGEM INSTANTÂNEA 0.8S // RESISTÊNCIA UV 100%">
                                <iconify-icon icon="solar:drop-bold-duotone" class="text-xs text-stone-300"></iconify-icon>
                                <span class="font-sans font-medium text-[10px] text-stone-200">Nano-Pigmento</span>
                            </button>

                            <button type="button"
                                class="node-btn absolute z-20 bottom-[16%] left-[6%] p-1.5 px-2.5 rounded-lg bg-stone-900/85 border border-white/20 hover:border-white/70 backdrop-blur-md text-white flex items-center gap-1.5 text-xs font-mono transition-all hover:scale-105 group/node shadow-none cursor-pointer"
                                data-id="3" data-name="CHASSI POLIMÉRICO MONOBLOCO 11.8G"
                                data-spec="CENTRO DE GRAVIDADE BARICÊNTRICO // ZERO FADIGA">
                                <iconify-icon icon="solar:shield-check-bold-duotone" class="text-xs text-stone-300"></iconify-icon>
                                <span class="font-sans font-medium text-[10px] text-stone-200">Chassi 11.8g</span>
                            </button>

                        </div>

                        <!-- Rodapé de Telemetria Dinâmica -->
                        <div
                            class="mt-2.5 pt-2.5 border-t border-white/10 flex flex-wrap items-center justify-between gap-2 text-[11px] font-mono">
                            <div class="flex items-center gap-2 text-stone-400">
                                <span class="text-stone-200 font-semibold text-[10px] sm:text-[11px]" id="telemetryName">MICROESFERA SUÍÇA 0.1 MM</span>
                                <span class="text-stone-600">|</span>
                                <span class="text-emerald-400 text-[10px] sm:text-[11px]" id="telemetrySpec">TOLERÂNCIA: ±0.002 MM</span>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Coluna Direita: 3 Tópicos Diretos no Formato 1. 2. 3. -->
                <div class="lg:col-span-6 flex flex-col justify-center space-y-4 sm:space-y-5">

                    <!-- Tópico 1 -->
                    <div class="arch-topic-item flex items-start gap-4 p-4 sm:p-5 rounded-2xl border border-stone-200/90 bg-stone-50/70 hover:border-stone-400 hover:bg-stone-50 transition-all shadow-xs">
                        <span class="font-mono text-2xl sm:text-3xl font-black text-stone-900 shrink-0 leading-none pt-0.5">1.</span>
                        <div>
                            <h3 class="font-display text-base sm:text-lg font-bold text-stone-900 mb-1">
                                Calibração Suíça 5-Eixos
                            </h3>
                            <p class="font-sans text-xs sm:text-sm text-stone-600 font-light leading-relaxed">
                                Esfera de carbeto de tungstênio com tolerância de ±0.002 mm. Traço milimétrico invariável de 0.1 mm do início ao fim.
                            </p>
                        </div>
                    </div>

                    <!-- Tópico 2 -->
                    <div class="arch-topic-item flex items-start gap-4 p-4 sm:p-5 rounded-2xl border border-stone-200/90 bg-stone-50/70 hover:border-stone-400 hover:bg-stone-50 transition-all shadow-xs">
                        <span class="font-mono text-2xl sm:text-3xl font-black text-stone-900 shrink-0 leading-none pt-0.5">2.</span>
                        <div>
                            <h3 class="font-display text-base sm:text-lg font-bold text-stone-900 mb-1">
                                Fluxo Isométrico Laminar
                            </h3>
                            <p class="font-sans text-xs sm:text-sm text-stone-600 font-light leading-relaxed">
                                Regulador ativo de vácuo interno. Liberação contínua de tinta Carbon Black sem falhas, borrões ou vazamentos.
                            </p>
                        </div>
                    </div>

                    <!-- Tópico 3 -->
                    <div class="arch-topic-item flex items-start gap-4 p-4 sm:p-5 rounded-2xl border border-stone-200/90 bg-stone-50/70 hover:border-stone-400 hover:bg-stone-50 transition-all shadow-xs">
                        <span class="font-mono text-2xl sm:text-3xl font-black text-stone-900 shrink-0 leading-none pt-0.5">3.</span>
                        <div>
                            <h3 class="font-display text-base sm:text-lg font-bold text-stone-900 mb-1">
                                Chassi Baricêntrico 11.8g
                            </h3>
                            <p class="font-sans text-xs sm:text-sm text-stone-600 font-light leading-relaxed">
                                Corpo monobloco em polímero aeroespacial. Equilíbrio de massa neutro na empunhadura para zero fadiga no papel.
                            </p>
                        </div>
                    </div>

                </div>

            </div>

            <!-- Linha de Transição Sutil para a Próxima Dobra -->
            <div class="w-full h-px bg-gradient-to-r from-transparent via-stone-300 to-transparent mt-10 md:mt-12 pointer-events-none"
                aria-hidden="true"></div>

        </div>
    </section>

    <!-- ==========================================================================
       SEÇÃO 03: O CUME DA MECATRÔNICA // CINEMATIC VIDEO & GLOW HIGHLIGHT BOX
