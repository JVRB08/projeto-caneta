---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ThoughtCards from '../components/ThoughtCards.astro';
import MarqueeSection from '../components/MarqueeSection.astro';
import WritingVideoSection from '../components/WritingVideoSection.astro';
import TechSpecsSection from '../components/TechSpecsSection.astro';
---

<Layout>
    <!-- Barra de Progresso Global na Borda Inferior -->
    <div class="global-scrub-bar fixed bottom-0 left-0 w-full h-[2px] bg-stone-300/40 z-50 pointer-events-none"
        aria-hidden="true">
        <div class="h-full w-0 bg-stone-900 transition-all duration-75" id="globalScrubFill"></div>
    </div>

    <!-- MAIN HERO (SCRUB TRACK + PALCO PINNED) -->
    <main class="hero-scrub-track relative" id="heroTrack">
        <section class="hero-stage flex items-center justify-center bg-[#EAEAE5]" id="heroStage"
            aria-label="Apresentação Interativa da Caneta ARTOOLS">

            <!-- Fundo Visual 100% Tela: Vídeo Nativo de Alta Fidelidade (Modelo video2.mp4) + Fallback Canvas -->
            <div class="absolute inset-0 w-full h-full pointer-events-none overflow-hidden z-0"
                id="visualContainer">
                <!-- Primário: Canvas Sequence (Padrão Apple - 60/120fps fluido) -->
                <canvas id="heroCanvas" class="hero-canvas" aria-label="Caneta ARTOOLS animada no canvas"></canvas>

                <!-- Motor Primário: Vídeo Nativo MP4 em Tela Cheia no Fundo do Hero -->
                <video id="heroVideo" class="hero-video" tabindex="-1" muted playsinline webkit-playsinline
                    preload="auto" src="/assets/videos/video2.mp4" aria-label="Vídeo coreografado da caneta ARTOOLS">
                    <source src="/assets/videos/video2.mp4" type="video/mp4">
                    <source src="/assets/raw_files/video2.mp4" type="video/mp4">
                    <source src="/video2.mp4" type="video/mp4">
                </video>
            </div>

            <!-- Palco em Primeiro Plano: Layout Exato da Referência Visual -->
            <div
                class="relative w-full max-w-[1440px] mx-auto h-full px-6 md:px-12 pt-20 pb-8 flex items-center justify-between z-20 pointer-events-none">

                <!-- Coluna Esquerda: Headline, Descrição e Botões -->
                <div class="w-full max-w-xl flex flex-col justify-center pointer-events-auto z-20"
                    id="heroLeftContent">

                    <!-- Headline Exata da Referência: "A caneta mais tecnológica do mundo." -->
                    <h1 class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-[5.5rem] font-bold tracking-tight leading-[0.92] mb-6 text-stone-900 flex flex-col items-start"
                        id="heroHeadline">
                        <span class="text-reveal-wrapper">
                            <span class="text-reveal-content">A caneta</span>
                        </span>
                        <span class="text-reveal-wrapper">
                            <span class="text-reveal-content delay-200 text-outline">mais tecnológica</span>
                        </span>
                        <span class="text-reveal-wrapper">
                            <span class="text-reveal-content delay-300">do mundo.</span>
                        </span>
                    </h1>

                    <!-- Texto de Apoio Exato da Referência -->
                    <p class="text-sm sm:text-base md:text-lg text-stone-600 max-w-lg leading-relaxed font-normal mb-8 text-balance"
                        id="heroDescription">
                        A Artools Precision Pen redefine o equilíbrio entre peso, fluxo e design. Feita para criadores que exigem perfeição em cada traço.
                    </p>

                    <!-- Botões de Ação no Padrão do Design System (Quadrados) -->
                    <div class="flex flex-wrap items-center gap-3.5" id="ctaGroup">
                        <a href="#buy" id="btnHeroBuy"
                            class="bg-stone-900 text-white px-7 py-3 rounded-none font-mono text-xs uppercase tracking-widest flex items-center justify-center gap-2 hover:bg-stone-800 transition-all cursor-pointer shadow-none">
                            <span>Comprar Agora</span>
                        </a>

                        <a href="#architectureSection" id="btnHeroExplore"
                            class="bg-white/90 border border-stone-300 text-stone-900 px-7 py-3 rounded-none font-mono text-xs uppercase tracking-widest flex items-center justify-center gap-2 hover:bg-white hover:border-stone-400 transition-all cursor-pointer shadow-none">
                            <span>Explorar ↓</span>
                        </a>
                    </div>
                </div>

            </div>

            <!-- Indicador Lateral 01 (Lado Direito da Tela como na referência) -->
            <div class="hidden md:flex absolute right-8 lg:right-12 top-1/2 -translate-y-1/2 flex-col items-center gap-3 font-mono text-[11px] text-stone-400 pointer-events-none z-30">
                <span class="font-medium text-stone-600">01</span>
                <div class="w-px h-12 bg-stone-300"></div>
            </div>

            <!-- Indicador Inferior Central (Referência: SCROLL TO CONTROL) -->
            <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 pointer-events-auto z-30"
                id="scrollHint">
                <span class="font-mono text-[10px] tracking-[0.25em] uppercase text-stone-400">SCROLL TO CONTROL</span>
                <div class="w-px h-6 bg-stone-300 relative overflow-hidden">
                    <div class="w-full h-full bg-stone-900 animate-scroll-line"></div>
                </div>
            </div>

        </section>
    </main>

    <!-- ==========================================================================
       MARQUEE TÉCNICO CONTÍNUO (AURA DESIGN SYSTEM)
       ========================================================================== -->
    <div class="relative w-full border-y border-stone-300/80 bg-stone-200/60 py-3 overflow-hidden z-20">
        <div
            class="animate-marquee whitespace-nowrap flex items-center gap-12 font-mono text-xs uppercase tracking-[0.22em] text-stone-600">
            <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-stone-900"></span> CALIBRE
                NOMINAL 0.1 MM</span>
            <span class="text-stone-400">/</span>
            <span>USINAGEM SUÍÇA 5-EIXOS (TOLERÂNCIA ±0.002 MM)</span>
            <span class="text-stone-400">/</span>
            <span>MICROESFERA CARBETO DE TUNGSTÊNIO 9.5 MOHS</span>
            <span class="text-stone-400">/</span>
            <span>NANO-PIGMENTO CARBON BLACK FÓSSIL</span>
            <span class="text-stone-400">/</span>
            <span>SECAGEM INSTANTÂNEA 0.8S ANTI-BORRÃO</span>
            <span class="text-stone-400">/</span>
            <span>100 ANOS DE ESTABILIDADE ARQUIVÍSTICA ISO 14145-2</span>
            <span class="text-stone-400">/</span>
            <span>CHASSI MONOBLOCO 11.8G EM POLÍMERO AEROESPACIAL</span>
            <span class="text-stone-400">/</span>
            <span>CENTRO DE GRAVIDADE BARICÊNTRICO ZERO-FADIGA</span>
            <span class="text-stone-400">/</span>
            <span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-stone-900"></span> CALIBRE
                NOMINAL 0.1 MM</span>
            <span class="text-stone-400">/</span>
            <span>USINAGEM SUÍÇA 5-EIXOS (TOLERÂNCIA ±0.002 MM)</span>
            <span class="text-stone-400">/</span>
            <span>MICROESFERA CARBETO DE TUNGSTÊNIO 9.5 MOHS</span>
            <span class="text-stone-400">/</span>
            <span>NANO-PIGMENTO CARBON BLACK FÓSSIL</span>
            <span class="text-stone-400">/</span>
            <span>SECAGEM INSTANTÂNEA 0.8S ANTI-BORRÃO</span>
            <span class="text-stone-400">/</span>
            <span>100 ANOS DE ESTABILIDADE ARQUIVÍSTICA ISO 14145-2</span>
            <span class="text-stone-400">/</span>
            <span>CHASSI MONOBLOCO 11.8G EM POLÍMERO AEROESPACIAL</span>
            <span class="text-stone-400">/</span>
            <span>CENTRO DE GRAVIDADE BARICÊNTRICO ZERO-FADIGA</span>
        </div>
    </div>

    <!-- ==========================================================================
       SEÇÃO 02: ARQUITETURA MECATRÔNICA & ENGENHARIA DE MATERIAIS
       (Dobra 02: Fundo 100% branco limpo, palavra de fundo no topo, elementos expandidos)
       ========================================================================== -->
    <section id="architectureSection"
        class="relative z-20 w-full bg-white text-stone-900 border-b border-stone-200 py-16 md:py-24 px-6 md:px-12 overflow-hidden"
        aria-label="Engenharia e Arquitetura do Produto">

        <!-- Marca d'Água Tipográfica Arquitetônica Gigante no Topo da Dobra -->
        <div
            class="absolute top-0 left-0 w-full overflow-hidden pointer-events-none select-none opacity-[0.035] leading-none text-[16vw] font-display font-black text-stone-900 whitespace-nowrap z-0">
            PRECISION // 0.1MM
        </div>

        <div class="max-w-[1440px] mx-auto relative z-10 w-full px-4 sm:px-6 md:px-12">

            <!-- Cabeçalho Expandido da Dobra 02 -->
            <div class="max-w-6xl mx-auto mb-12 md:mb-16 arch-header-reveal">
                <!-- Headline em 2 Linhas Ampliada -->
                <h2 class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight leading-[1.02] mb-5">
                    <span class="block text-stone-900">Engenharia Suíça.</span>
                    <span class="block text-stone-400 font-medium">Precisão Molecular.</span>
                </h2>

                <!-- Subtitle Ampliado -->
                <p class="font-sans text-base sm:text-lg md:text-xl text-stone-600 font-light max-w-3xl leading-relaxed">
                    Nossa arquitetura de fluxo proprietária sincroniza a deposição de tinta em tempo real. Construída sobre um chassi de alumínio aeroespacial usinado em CNC de 5 eixos.
                </p>
            </div>

            <!-- Grid de 2 Colunas Ampliado: Card com Caneta à Esquerda + 3 Tópicos à Direita -->
            <div class="w-full max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">

                <!-- Coluna Esquerda: Card Ampliado com a Caneta do Catálogo + Badges -->
                <div class="lg:col-span-7 flex flex-col arch-visual-card-wrap">
                    <div class="relative w-full aspect-[4/3] rounded-3xl overflow-hidden bg-stone-950 border border-stone-300 shadow-2xl group"
                        id="schematicCard">

                        <!-- Imagem da Caneta do Catálogo (ARTOOLS Raw Titanium 0.3) -->
                        <img src="/assets/images/pens/pen_raw_titanium.jpg"
                            alt="ARTOOLS Raw Titanium 0.3 em usinagem aeroespacial CNC"
                            class="w-full h-full object-cover object-center scale-100 group-hover:scale-105 transition-transform duration-700 ease-out"
                            id="schematicPenImg" />

                        <!-- Vinheta Sutil de Destaque -->
                        <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-black/10 pointer-events-none"></div>

                        <!-- Badge Flutuante Superior Esquerdo (Glass Chip Ampliado) -->
                        <div class="absolute top-5 left-5 sm:top-7 sm:left-7 backdrop-blur-md bg-white/20 border border-white/30 rounded-2xl p-3 px-3.5 shadow-xl flex flex-col justify-between w-16 h-12 sm:w-20 sm:h-14">
                            <div class="w-5 h-4 rounded-xs border border-white/40 bg-white/30"></div>
                            <div class="w-10 h-1.5 bg-white/40 rounded-full"></div>
                        </div>

                        <!-- Badge Flutuante Inferior Direito (0.3 TIP PRECISION Ampliado) -->
                        <div class="absolute bottom-5 right-5 sm:bottom-7 sm:right-7 backdrop-blur-md bg-stone-900/85 border border-white/20 rounded-2xl px-5 py-3 sm:px-6 sm:py-3.5 shadow-2xl text-center">
                            <span class="block font-display text-2xl sm:text-3xl font-bold text-white leading-none tracking-tight">0.3</span>
                            <span class="block font-mono text-[10px] sm:text-[11px] uppercase tracking-wider text-stone-300 mt-1">TIP PRECISION</span>
                        </div>

                    </div>
                </div>

                <!-- Coluna Direita: 3 Tópicos Ampliados (01, 02, 03) -->
                <div class="lg:col-span-5 flex flex-col justify-center space-y-9 sm:space-y-12">

                    <!-- Tópico 01 -->
                    <div class="arch-topic-item">
                        <span class="font-mono text-sm sm:text-base text-stone-400 block mb-2 font-semibold tracking-wider">01</span>
                        <h3 class="font-display text-xl sm:text-2xl md:text-3xl font-bold text-stone-900 mb-2.5">
                            Alumínio Aeroespacial
                        </h3>
                        <p class="font-sans text-sm sm:text-base text-stone-600 font-light leading-relaxed">
                            Estrutura monobloco usinada em Alumínio 6061-T6. Leveza extrema (14g) com resistência estrutural de nível militar.
                        </p>
                    </div>

                    <!-- Tópico 02 -->
                    <div class="arch-topic-item">
                        <span class="font-mono text-sm sm:text-base text-stone-400 block mb-2 font-semibold tracking-wider">02</span>
                        <h3 class="font-display text-xl sm:text-2xl md:text-3xl font-bold text-stone-900 mb-2.5">
                            Fluxo Híbrido
                        </h3>
                        <p class="font-sans text-sm sm:text-base text-stone-600 font-light leading-relaxed">
                            Sistema de tinta de baixa viscosidade com regulação por capilaridade assistida. O traço nunca falha até 15°.
                        </p>
                    </div>

                    <!-- Tópico 03 -->
                    <div class="arch-topic-item">
                        <span class="font-mono text-sm sm:text-base text-stone-400 block mb-2 font-semibold tracking-wider">03</span>
                        <h3 class="font-display text-xl sm:text-2xl md:text-3xl font-bold text-stone-900 mb-2.5">
                            Grip Texturizado
                        </h3>
                        <p class="font-sans text-sm sm:text-base text-stone-600 font-light leading-relaxed">
                            Micro-usinagem a laser cria uma superfície de aderência perfeita (Ra 0.8µm) sem acumular resíduos.
                        </p>
                    </div>

                </div>

            </div>

            <!-- Linha de Transição Sutil para a Próxima Dobra -->
            <div class="w-full h-px bg-gradient-to-r from-transparent via-stone-300 to-transparent mt-10 md:mt-12 pointer-events-none"
                aria-hidden="true"></div>

        </div>
    </section>

    <!-- ==========================================================================
       SEÇÃO 03: ARCHITECTURE OF THOUGHT // CARDS DE PRECISÃO CONCEITUAL
       (Dobra 3: Ampliada // Fundo 100% Branco com o Componente ThoughtCards)
       ========================================================================== -->
    <section id="cinematicGlowSection"
        class="relative z-20 w-full bg-white text-stone-900 py-24 md:py-36 px-6 md:px-12 overflow-hidden border-b border-stone-200"
        aria-label="Architecture of Thought">

        <div class="max-w-6xl mx-auto relative z-10 flex flex-col items-center">

            <!-- Cabeçalho Editorial Ampliado da Dobra 03 -->
            <div class="text-center max-w-4xl mb-16 md:mb-20 cinematic-header-reveal">
                <!-- Eyebrow Discreto -->
                <p class="font-mono text-xs sm:text-sm uppercase tracking-[0.28em] text-stone-500 mb-5 font-semibold">
                    ARCHITECTURE OF THOUGHT
                </p>

                <!-- Headline em 2 Linhas Ampliada: Preto Sólido + Cinza Suave -->
                <h2 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.04] text-balance">
                    <span class="block text-stone-950">A ferramenta invisível para</span>
                    <span class="block text-stone-400 font-medium">ideias tangíveis.</span>
                </h2>
            </div>

            <!-- Cards Conceituais Ampliados da 3ª Dobra via Componente Astro -->
            <ThoughtCards />
        </div>
    </section>

    <!-- NOVA DOBRA: MARQUEE INFINITO (100% PRETO // FONTE CURSIVA) -->
    <MarqueeSection />

    <!-- NOVA DOBRA: VÍDEO FIXADO (SEM OVERLAY // ALTURA 70% MAIOR QUE O MARQUEE) -->
    <WritingVideoSection />

    <!-- NOVA DOBRA: TABELA DE ESPECIFICAÇÕES TÉCNICAS (100% PRETO // FONTE EDITORIAL ITÁLICA) -->
    <TechSpecsSection />

    <!-- Modal para Destino de Compra não configurado -->
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-stone-900/40 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
        id="modalBackdrop" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <div class="bg-white border border-stone-300 rounded-lg p-8 max-w-md w-full shadow-2xl transform translate-y-4 transition-transform duration-300"
            id="modalBox">
            <div class="flex justify-between items-center mb-4">
                <span
                    class="font-mono text-xs uppercase tracking-widest text-stone-500 bg-stone-100 px-2 py-0.5 rounded">Configuração
                    Pendente</span>
                <Button rounded="rounded-none" variant="ghost"
                    id="modalCloseBtn"
                    icon="solar:close-circle-linear"
                    aria-label="Fechar janela"
                />
            </div>
            <h3 class="font-display text-xl font-semibold text-stone-900 mb-2" id="modalTitle">Destino de Compra não
                configurado</h3>
            <p class="font-sans text-sm text-stone-600 leading-relaxed mb-6">
                Conforme as regras do projeto, nenhum destino fictício de checkout foi simulado. Para ativar a compra
                direta, configure a propriedade <strong>buyUrl</strong> no objeto de configuração no início do script:
                <code
                    class="block mt-2 p-3 bg-stone-100 border border-stone-200 rounded font-mono text-xs text-stone-900">CONFIG.buyUrl = "https://sua-loja.com.br/checkout";</code>
            </p>
            <div class="flex justify-end">
                <Button rounded="rounded-none" id="modalOkBtn"
                    size="sm"
                >
                    Entendido
                </Button>
            </div>
        </div>
    </div>

    <!-- ==========================================================================
       JAVASCRIPT: CONTROLE MULTI-STACK DE SCRUBBING COM MOTION PRIMITIVES AURA
       ========================================================================== -->
    <script is:inline>
        /**
         * CONFIGURAÇÃO CENTRALIZADA DA EXPERIÊNCIA
         */
        const CONFIG = {
            // Engine ativa padrão: 'video' (Vídeo nativo com exato modelo video2.mp4)
            renderEngine: 'video',

            // Vídeo MP4 com o modelo exato fornecido
            videoSrc: '/assets/videos/video2.mp4',
            videoFallbackSrc: '/assets/raw_files/video2.mp4',
            videoRootFallback: '/video2.mp4',
            seekThreshold: 0.02,

            // Sequência de frames reais (modo alternativo)
            frameCount: 192,
            framePathPrefix: '/assets/video_frames/frame_',
            frameExtension: '.jpg',

            // Parâmetros de física e rolagem
            scrubSmoothingVideo: 0.15,
            scrubSmoothingCanvas: 0.1,
            exploreTargetProgress: 0.65,

            // URL para o checkout / página de compra
            buyUrl: ""
        };

        // Função do efeito Flashlight do Design System
        function updateFlashlight(e, card) {
        window.updateFlashlight = updateFlashlight;
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            card.style.setProperty('--mouse-x', `${x}px`);
            card.style.setProperty('--mouse-y', `${y}px`);
        }

        /* ==========================================================================
           STACK PRINCIPAL: NATIVE HTML5 VIDEO SCRUBBER ENGINE (PRECISÃO ABSOLUTA)
           ========================================================================== */
        class PrecisionVideoScrubber {
            constructor(videoElement, options = {}) {
                this.video = videoElement;
                this.duration = 0;
                this.targetProgress = 0;
                this.currentProgress = 0;
                this.isSeeking = false;
                this.pendingTime = null;
                this.isReady = false;
                this.rafId = null;

                this._init();
            }

            _init() {
                this.video.muted = true;
                this.video.playsInline = true;
                this.video.setAttribute('webkit-playsinline', 'true');
                this.video.setAttribute('playsinline', 'true');
                this.video.preload = 'auto';

                const onMeta = () => {
                    if (this.video.duration && !isNaN(this.video.duration) && this.video.duration > 0) {
                        this.duration = this.video.duration;
                        this.isReady = true;
                        // Força renderização do primeiro frame no carregamento
                        try {
                            this.video.currentTime = 0.01;
                        } catch (e) { }
                    }
                };

                if (this.video.readyState >= 1) {
                    onMeta();
                } else {
                    this.video.addEventListener('loadedmetadata', onMeta, { once: true });
                }

                this.video.addEventListener('seeked', () => {
                    this.isSeeking = false;
                    if (this.pendingTime !== null) {
                        const next = this.pendingTime;
                        this.pendingTime = null;
                        this._applySeek(next);
                    }
                });

                this.video.addEventListener('seeking', () => {
                    this.isSeeking = true;
                });

                // Inicia loop de renderização contínuo
                this._loop = this._loop.bind(this);
                this.rafId = requestAnimationFrame(this._loop);

                // Garante que o vídeo seja carregado pelo navegador
                try {
                    this.video.load();
                } catch (e) { }
            }

            setProgress(progress) {
                this.targetProgress = Math.max(0, Math.min(1, progress));
            }

            _applySeek(time) {
                if (this.isSeeking) {
                    this.pendingTime = time;
                    return;
                }
                this.isSeeking = true;
                try {
                    this.video.currentTime = time;
                } catch (err) {
                    this.isSeeking = false;
                }
            }

            _loop() {
                if (this.isReady && this.duration > 0) {
                    const diff = this.targetProgress - this.currentProgress;
                    if (Math.abs(diff) > 0.0001) {
                        // Interpolação ultra-suave e cadenciada (lerp 0.08) para desacelerar o movimento tanto para baixo quanto para cima
                        this.currentProgress += diff * 0.08;
                        const targetTime = Math.max(0, Math.min(this.duration - 0.02, this.currentProgress * (this.duration - 0.02)));
                        if (Math.abs(this.video.currentTime - targetTime) > 0.01) {
                            this._applySeek(targetTime);
                        }
                    }
                }
                this.rafId = requestAnimationFrame(this._loop);
            }

            destroy() {
                if (this.rafId) cancelAnimationFrame(this.rafId);
            }
        }

        /* ==========================================================================
           STACK SECUNDÁRIO: CANVAS IMAGE SEQUENCE ENGINE (FALLBACK / MODO ALTERNATIVO)
           ========================================================================== */
        class AppleStyleCanvasScrubber {
            constructor(canvasElement, config) {
                this.canvas = canvasElement;
                this.ctx = canvasElement.getContext('2d', { alpha: false });
                this.config = config;
                this.frameCount = config.frameCount;
                this.images = new Array(this.frameCount);
                this.loadedCount = 0;
                this.currentFrameIndex = 0;
                this.isReady = false;

                this._init();
            }

            _getFrameUrl(index) {
                const numStr = (index + 1).toString().padStart(4, '0');
                return `${this.config.framePathPrefix}${numStr}${this.config.frameExtension}`;
            }

            _init() {
                for (let i = 0; i < this.frameCount; i++) {
                    const img = new Image();
                    img.src = this._getFrameUrl(i);
                    img.onload = () => {
                        this.images[i] = img;
                        this.loadedCount++;
                        if (!this.isReady && i === 0) {
                            this.isReady = true;
                            this.drawFrame(0);
                        }
                        if (i === this.currentFrameIndex) {
                            this.drawFrame(i);
                        }
                    };
                }
            }

            setNormalizedProgress(progress) {
                const safeProgress = Math.max(0, Math.min(1, progress));
                const targetIndex = Math.min(
                    this.frameCount - 1,
                    Math.floor(safeProgress * (this.frameCount - 1))
                );
                this.currentFrameIndex = targetIndex;
                this.drawFrame(targetIndex);
            }

            drawFrame(index) {
                let imgToDraw = this.images[index];
                if (!imgToDraw || !imgToDraw.complete || imgToDraw.naturalWidth === 0) {
                    for (let delta = 1; delta < this.frameCount; delta++) {
                        if (index - delta >= 0 && this.images[index - delta] && this.images[index - delta].complete && this.images[index - delta].naturalWidth > 0) {
                            imgToDraw = this.images[index - delta];
                            break;
                        }
                        if (index + delta < this.frameCount && this.images[index + delta] && this.images[index + delta].complete && this.images[index + delta].naturalWidth > 0) {
                            imgToDraw = this.images[index + delta];
                            break;
                        }
                    }
                }

                if (!imgToDraw || !imgToDraw.complete || imgToDraw.naturalWidth === 0) return;

                const dpr = Math.min(window.devicePixelRatio || 1, 2);
                const cw = this.canvas.clientWidth || window.innerWidth;
                const ch = this.canvas.clientHeight || window.innerHeight;

                const targetW = Math.floor(cw * dpr);
                const targetH = Math.floor(ch * dpr);

                if (this.canvas.width !== targetW || this.canvas.height !== targetH) {
                    this.canvas.width = targetW;
                    this.canvas.height = targetH;
                }

                this.ctx.save();
                this.ctx.scale(dpr, dpr);

                const imgW = imgToDraw.naturalWidth || 1280;
                const imgH = imgToDraw.naturalHeight || 720;
                const imgAspect = imgW / imgH;
                const canvasAspect = cw / ch;

                let renderW, renderH, offsetX, offsetY;

                if (canvasAspect > imgAspect) {
                    renderW = cw;
                    renderH = cw / imgAspect;
                    offsetX = 0;
                    offsetY = (ch - renderH) * 0.5;
                } else {
                    renderH = ch;
                    renderW = ch * imgAspect;
                    const focalX = window.innerWidth > 768 ? 0.60 : 0.5;
                    offsetX = (cw - renderW) * focalX;
                    offsetY = (ch - renderH) * 0.5;
                }

                this.ctx.drawImage(imgToDraw, offsetX, offsetY, renderW, renderH);
                this.ctx.restore();
            }

            resize() {
                this.drawFrame(this.currentFrameIndex);
            }
        }

        /* ==========================================================================
           ORQUESTRADOR GERAL
           ========================================================================== */
        document.addEventListener('DOMContentLoaded', () => {
            const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            // Elementos DOM
            const heroTrack = document.getElementById('heroTrack');
            const heroCanvas = document.getElementById('heroCanvas');
            const heroVideo = document.getElementById('heroVideo');
            const heroLeftContent = document.getElementById('heroLeftContent');
            const editorialRail = document.getElementById('editorialRail');
            const heroBadge = document.getElementById('heroBadge');
            const heroHeadline = document.getElementById('heroHeadline');
            const heroDescription = document.getElementById('heroDescription');
            const ctaGroup = document.getElementById('ctaGroup');
            const cardSpec1 = document.getElementById('cardSpec1');
            const cardSpec2 = document.getElementById('cardSpec2');
            const cardSpec3 = document.getElementById('cardSpec3');
            const studioBadge = document.getElementById('studioBadge');
            const scrollHint = document.getElementById('scrollHint');
            const btnEngineCanvas = document.getElementById('btnEngineCanvas');
            const btnEngineVideo = document.getElementById('btnEngineVideo');
            const globalScrubFill = document.getElementById('globalScrubFill');
            const btnHeroBuy = document.getElementById('btnHeroBuy');
            const btnNavBuy = document.getElementById('btnNavBuy');
            const btnHeroExplore = document.getElementById('btnHeroExplore');
            const modalBackdrop = document.getElementById('modalBackdrop');
            const modalBox = document.getElementById('modalBox');
            const modalCloseBtn = document.getElementById('modalCloseBtn');
            const modalOkBtn = document.getElementById('modalOkBtn');

            // Handlers do Modal de Compra
            const openBuyNotice = () => {
                if (CONFIG.buyUrl && CONFIG.buyUrl.trim() !== "") {
                    window.location.href = CONFIG.buyUrl;
                } else {
                    modalBackdrop.classList.remove('opacity-0', 'pointer-events-none');
                    modalBox.classList.remove('translate-y-4');
                }
            };
            const closeBuyNotice = () => {
                modalBackdrop.classList.add('opacity-0', 'pointer-events-none');
                modalBox.classList.add('translate-y-4');
            };

            if (btnHeroBuy) btnHeroBuy.addEventListener('click', openBuyNotice);
            if (btnNavBuy) btnNavBuy.addEventListener('click', openBuyNotice);
            if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeBuyNotice);
            if (modalOkBtn) modalOkBtn.addEventListener('click', closeBuyNotice);
            modalBackdrop.addEventListener('click', (e) => {
                if (e.target === modalBackdrop) closeBuyNotice();
            });

            // Inicialização do Lenis Smooth Scroll
            let lenis = null;
            try {
                if (typeof Lenis !== 'undefined') {
                    lenis = new Lenis({
                        lerp: 0.09,
                        wheelMultiplier: 1.0,
                        touchMultiplier: 1.5,
                        smoothWheel: true,
                        smoothTouch: false
                    });
                    lenis.on('scroll', ScrollTrigger.update);
                    gsap.ticker.add((time) => lenis.raf(time * 1000));
                    gsap.ticker.lagSmoothing(0);
                }
            } catch (err) {
                console.warn('[Lenis] Usando rolagem nativa:', err);
            }

            // Registro do GSAP ScrollTrigger
            gsap.registerPlugin(ScrollTrigger);

            // Instanciação do Motor de Vídeo MP4 (Modelo Exato Fornecido)
            let activeEngine = CONFIG.renderEngine;
            const videoScrubber = new PrecisionVideoScrubber(heroVideo);
            const canvasScrubber = new AppleStyleCanvasScrubber(heroCanvas, CONFIG);

            function switchEngine(mode) {
                activeEngine = mode;
                if (mode === 'canvas') {
                    heroCanvas.style.display = 'block';
                    heroVideo.style.display = 'none';
                    if (btnEngineCanvas) btnEngineCanvas.classList.add('active');
                    if (btnEngineVideo) btnEngineVideo.classList.remove('active');
                    canvasScrubber.resize();
                } else {
                    heroCanvas.style.display = 'none';
                    heroVideo.style.display = 'block';
                    if (btnEngineCanvas) btnEngineCanvas.classList.remove('active');
                    if (btnEngineVideo) btnEngineVideo.classList.add('active');
                }
                ScrollTrigger.refresh();
            }

            if (btnEngineCanvas) btnEngineCanvas.addEventListener('click', () => switchEngine('canvas'));
            if (btnEngineVideo) btnEngineVideo.addEventListener('click', () => switchEngine('video'));
            switchEngine('video'); // Vídeo nativo como padrão absoluto

            // ======================================================================
            // 1. ANIMAÇÃO DE ENTRADA: CLASSES DO DESIGN SYSTEM (.reveal.active & .reveal-active)
            // ======================================================================
            requestAnimationFrame(() => {
                document.querySelectorAll('.text-reveal-wrapper').forEach(wrapper => {
                    wrapper.classList.add('reveal-active');
                });
                document.querySelectorAll('.reveal').forEach(el => {
                    el.classList.add('active');
                });
            });

            // ======================================================================
            // 2. SINCRONIZAÇÃO DIRETA DE SCRUBBING (GARANTE MOVIMENTO CONTÍNUO E FLUIDO)
            // ======================================================================
            function updateHeroScroll(progressFromTrigger) {
                let p = progressFromTrigger;
                if (typeof p !== 'number') {
                    const rect = heroTrack.getBoundingClientRect();
                    const totalScrollable = heroTrack.offsetHeight - window.innerHeight;
                    if (totalScrollable > 0) {
                        const scrolled = -rect.top;
                        p = Math.max(0, Math.min(1, scrolled / totalScrollable));
                    } else {
                        p = 0;
                    }
                }

                if (activeEngine === 'video') {
                    videoScrubber.setProgress(p);
                } else {
                    canvasScrubber.setNormalizedProgress(p);
                }

                if (globalScrubFill) {
                    globalScrubFill.style.width = (p * 100).toFixed(1) + "%";
                }

                if (p > 0.25) {
                    if (heroLeftContent) heroLeftContent.style.pointerEvents = "none";
                    if (editorialRail) editorialRail.style.pointerEvents = "none";
                } else {
                    if (heroLeftContent) heroLeftContent.style.pointerEvents = "auto";
                    if (editorialRail) editorialRail.style.pointerEvents = "auto";
                }
            }

            window.addEventListener('scroll', () => updateHeroScroll(), { passive: true });
            if (lenis) lenis.on('scroll', () => updateHeroScroll());

            // ======================================================================
            // 3. TIMELINE MESTRE COM PINNING COMPACTO E AMORTECIMENTO SUAVE (ROLAGEM LENTA)
            // ======================================================================
            const masterHeroTimeline = gsap.timeline({
                scrollTrigger: {
                    trigger: heroTrack,
                    pin: heroStage,
                    start: "top top",
                    end: "bottom bottom",
                    scrub: 0.6,
                    onUpdate: (self) => {
                        updateHeroScroll(self.progress);
                    }
                }
            });

            // Os textos, botões e elementos da referência visual PERMANECEM VISÍVEIS durante a rotação da caneta!
            // Eles só realizam a transição suave de saída no final da rolagem (após 78% da rotação) para dar lugar à Dobra 2.
            masterHeroTimeline
                .to(heroLeftContent, {
                    y: -35,
                    opacity: 0,
                    filter: "blur(8px)",
                    duration: 0.2,
                    ease: "power2.in"
                }, 0.78)
                .to(scrollHint, {
                    opacity: 0,
                    y: 12,
                    duration: 0.15,
                    ease: "power2.in"
                }, 0.78);

            // ======================================================================
            // 4. ANIMAÇÕES DA SEÇÃO 02: ARQUITETURA DE PRECISÃO (ESTÁVEL E PERMANENTE)
            // ======================================================================
            const archSection = document.getElementById('architectureSection');
            if (archSection) {
                const archTl = gsap.timeline({
                    scrollTrigger: {
                        trigger: archSection,
                        start: "top 85%",
                        once: true
                    }
                });

                archTl
                    .from(".arch-header-reveal", {
                        y: 35,
                        opacity: 0,
                        duration: 0.9,
                        ease: "power2.out",
                        clearProps: "all"
                    })
                    .from(".arch-visual-card-wrap", {
                        scale: 0.96,
                        y: 30,
                        opacity: 0,
                        duration: 1.0,
                        ease: "power2.out",
                        clearProps: "all"
                    }, "-=0.6")
                    .from(".arch-topic-item", {
                        x: 25,
                        opacity: 0,
                        stagger: 0.12,
                        duration: 0.7,
                        ease: "power2.out",
                        clearProps: "all"
                    }, "-=0.5");
            }

            // Botão "Explorar": navega suavemente para a Seção 02 (Arquitetura)
            if (btnHeroExplore) {
                btnHeroExplore.addEventListener('click', () => {
                    if (archSection) {
                        if (lenis) {
                            lenis.scrollTo(archSection, {
                                offset: 0,
                                duration: 1.8,
                                easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t))
                            });
                        } else {
                            archSection.scrollIntoView({ behavior: 'smooth' });
                        }
                    }
                });
            }

            // ======================================================================
            // 5. ANIMAÇÕES DA SEÇÃO 03: ARCHITECTURE OF THOUGHT (SEM FLICKER OU SUMIÇO)
            // ======================================================================
            const cinematicSection = document.getElementById('cinematicGlowSection');
            if (cinematicSection) {
                const cinematicTl = gsap.timeline({
                    scrollTrigger: {
                        trigger: cinematicSection,
                        start: "top 85%",
                        once: true
                    }
                });

                cinematicTl
                    .from(".cinematic-header-reveal", {
                        y: 35,
                        opacity: 0,
                        duration: 0.9,
                        ease: "power2.out",
                        clearProps: "all"
                    })
                    .from(".cinematic-glow-card-wrap", {
                        y: 35,
                        opacity: 0,
                        duration: 0.9,
                        stagger: 0.14,
                        ease: "power2.out",
                        clearProps: "all"
                    }, "-=0.6");
            }

            // Redimensionamento
            window.addEventListener('resize', () => {
                canvasScrubber.resize();
                ScrollTrigger.refresh();
            });
        });
    </script>
</Layout>
