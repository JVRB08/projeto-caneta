---
interface FeatureCard {
  title: string;
  description: string;
  icon: string;
  initialLineWidth?: string;
}

interface Props {
  cards?: FeatureCard[];
  class?: string;
}

const defaultCards: FeatureCard[] = [
  {
    title: "Resposta Háptica",
    description: "O amortecimento micrométrico da ponta transmite a textura do papel diretamente aos seus dedos com sensibilidade incomparável.",
    icon: "pulse",
    initialLineWidth: "w-36"
  },
  {
    title: "Pigmento Molecular",
    description: "Nanopartículas de carbono que se fundem às fibras celulósicas em 0.8s, imunes à luz solar, umidade e ao passar dos anos.",
    icon: "molecule",
    initialLineWidth: "w-24"
  },
  {
    title: "Inércia Nula",
    description: "Distribuição geométrica de massa que anula o peso percebido na ponta dos dedos, criando a sensação de que a caneta flutua.",
    icon: "orbit",
    initialLineWidth: "w-14"
  }
];

const { cards = defaultCards, class: className = "" } = Astro.props;
---

<!-- COMPONENTE: 3 CARDS CONCEITUAIS AMPLIADOS COM MOVIMENTO, FLUIDEZ E SOMBREAMENTO -->
<div class:list={["grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10 w-full max-w-6xl items-stretch", className]}>
  {cards.map((card) => (
    <div class="cinematic-glow-card-wrap relative bg-gradient-to-b from-white/95 to-white/80 hover:bg-white backdrop-blur-xl border border-stone-200/90 hover:border-stone-400/90 p-9 sm:p-11 rounded-3xl min-h-[420px] sm:min-h-[460px] shadow-[0_12px_35px_rgba(0,0,0,0.06)] hover:shadow-[0_25px_60px_rgba(0,0,0,0.13)] hover:-translate-y-3 transition-all duration-500 ease-out flex flex-col justify-between group overflow-hidden">
      <!-- Brilho Atmosférico Fluido no Hover -->
      <div class="absolute -top-24 -right-24 w-56 h-56 bg-stone-200/50 rounded-full blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>

      <div class="relative z-10">
        <!-- Ícone em Badge Quadrado Arredondado Ampliado com Animação -->
        <div class="w-14 h-14 rounded-2xl bg-stone-100/90 border border-stone-200/80 flex items-center justify-center mb-8 text-stone-800 shadow-xs group-hover:scale-110 group-hover:-translate-y-1.5 group-hover:bg-white group-hover:shadow-md transition-all duration-500">
          {card.icon === 'pulse' && (
            <svg class="w-6 h-6 text-stone-800" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
            </svg>
          )}
          {card.icon === 'molecule' && (
            <svg class="w-6 h-6 text-stone-800" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="3.5" stroke="currentColor" />
              <circle cx="19" cy="8" r="2.2" stroke="currentColor" />
              <circle cx="5" cy="16" r="2.2" stroke="currentColor" />
              <path stroke-linecap="round" d="M14.5 10.5L17.5 9M9.5 13.5L6.5 15" />
            </svg>
          )}
          {card.icon === 'orbit' && (
            <svg class="w-6 h-6 text-stone-800" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <ellipse cx="12" cy="12" rx="9" ry="4" transform="rotate(-25 12 12)" stroke="currentColor" />
              <circle cx="12" cy="12" r="2.5" fill="currentColor" />
            </svg>
          )}
        </div>

        <!-- Título Ampliado -->
        <h3 class="font-display text-2xl sm:text-3xl font-bold text-stone-900 mb-4 tracking-tight group-hover:text-black transition-colors duration-300">
          {card.title}
        </h3>

        <!-- Descrição Ampliada -->
        <p class="font-sans text-sm sm:text-base text-stone-600 font-light leading-relaxed">
          {card.description}
        </p>
      </div>

      <!-- Linha Indicadora Fluida com Movimento no Hover -->
      <div class="pt-12 relative z-10">
        <div class="w-full bg-stone-200/80 h-[2.5px] rounded-full overflow-hidden">
          <div class:list={["h-full bg-stone-900 group-hover:w-full transition-all duration-700 ease-out rounded-full", card.initialLineWidth || "w-32"]}></div>
        </div>
      </div>
    </div>
  ))}
</div>

