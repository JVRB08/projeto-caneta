---
import Button from './Button.astro';

interface EngineeringCard {
  tag: string;
  badge: string;
  metricLabel: string;
  metricValue: string;
  title: string;
  description: string;
  footerIcon: string;
  footerLeft: string;
  footerRight: string;
}

interface Props {
  cards?: EngineeringCard[];
  ctaText?: string;
  ctaAction?: string;
  class?: string;
}

const defaultCards: EngineeringCard[] = [
  {
    tag: "01 // MICROESFERA",
    badge: "9.5 MOHS",
    metricLabel: "TOLERÂNCIA DIMENSIONAL",
    metricValue: "±0.002 mm",
    title: "Esfera em Carbeto de Tungstênio",
    description: "Usinagem suíça de 5 eixos com dureza próxima ao diamante. Mantém esfericidade pura sem desgaste ou deformação mesmo sob uso intensivo contínuo.",
    footerIcon: "solar:shield-check-bold",
    footerLeft: "Usinagem Suíça 5-Eixos",
    footerRight: "Precisão 99.98%"
  },
  {
    tag: "02 // HIDRODINÂMICA",
    badge: "PRESSÃO NULA",
    metricLabel: "SECAGEM MOLECULAR",
    metricValue: "0.8s",
    title: "Fluxo Laminar Capilar",
    description: "Deposição acionada por pura tensão superficial e gravidade. O traço flui sem exigir pressão da mão, eliminando resíduos secos e falhas de linha.",
    footerIcon: "solar:waterdrop-bold",
    footerLeft: "Zero Resíduo Seco",
    footerRight: "Deposição 0g"
  },
  {
    tag: "03 // LONGEVIDADE",
    badge: "SERIADO 2026",
    metricLabel: "AUTONOMIA DE TRAÇO",
    metricValue: "1.200 m",
    title: "Calibração e Rastreabilidade",
    description: "Mais de 1.200 metros de linha contínua sem perda de tom ou densidade ótica. Chassi monobloco numerado com certificado vitalício de alinhamento.",
    footerIcon: "solar:verified-check-bold",
    footerLeft: "Garantia Vitalícia",
    footerRight: "Lote Numerado"
  }
];

const {
  cards = defaultCards,
  ctaText = "ADQUIRIR SÉRIE ARTOOLS",
  ctaAction = "document.getElementById('btnHeroBuy').click()",
  class: className = ""
} = Astro.props;
---

<!-- 3 CARDS DE ENGENHARIA OBJETIVOS COM EFEITO CONIC GLOW BEAM -->
<div class:list={["w-full max-w-6xl", className]}>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5 lg:gap-6 w-full items-stretch">
    {cards.map((card) => (
      <div class="relative w-full cinematic-glow-card-wrap flex flex-col group">
        <!-- Halo de Glow Atmosférico Traseiro -->
        <div class="glow-box-halo opacity-40 group-hover:opacity-75 transition-opacity"></div>

        <!-- Container com Borda Animada em Rotação Contínua (Conic-Gradient Beam) -->
        <div class="glow-box-wrapper shadow-2xl flex-1 flex flex-col h-full">
          <div class="glow-beam-rotator"></div>

          <!-- Corpo Principal do Box (Glassmorphism Dark de Alto Padrão) -->
          <div class="relative z-10 rounded-[calc(1.75rem-1.5px)] bg-[#0C0C10]/90 backdrop-blur-2xl border border-white/15 p-6 md:p-7 flex flex-col justify-between h-full overflow-hidden flex-1">
            
            <!-- Blueprint Grid de Fundo Sutil -->
            <div
              class="absolute inset-0 bg-grid opacity-10 pointer-events-none"
              style="background-size: 20px 20px; background-image: linear-gradient(to right, rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.1) 1px, transparent 1px);"
            ></div>

            <!-- Top Ribbon de Telemetria -->
            <div class="relative z-10 flex items-center justify-between pb-3.5 mb-5 border-b border-white/10 font-mono text-xs">
              <div class="flex items-center gap-2 text-neutral-300 uppercase tracking-widest text-[10px]">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                <span class="text-white font-semibold">{card.tag}</span>
              </div>
              <span class="px-2.5 py-0.5 rounded-full bg-white/10 text-emerald-300 text-[10px] uppercase font-bold tracking-wider border border-white/10">
                {card.badge}
              </span>
            </div>

            <!-- Conteúdo Central -->
            <div class="relative z-10 flex-1 flex flex-col">
              <!-- Métrica Principal em Destaque -->
              <div class="mb-4">
                <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-neutral-400 block mb-1">
                  {card.metricLabel}
                </span>
                <div class="font-display text-3xl sm:text-4xl font-bold text-white tracking-tight">
                  {card.metricValue}
                </div>
              </div>

              <h3 class="font-display text-lg sm:text-xl font-bold text-white tracking-tight leading-snug mb-2.5">
                {card.title}
              </h3>

              <p class="text-neutral-300 text-xs sm:text-[13px] font-light leading-relaxed mb-6 flex-1">
                {card.description}
              </p>
            </div>

            <!-- Rodapé / Micro-Telemetria Inferior -->
            <div class="relative z-10 pt-4 border-t border-white/10 flex items-center justify-between font-mono text-[11px] text-neutral-400">
              <span class="flex items-center gap-1.5 text-neutral-300">
                <iconify-icon icon={card.footerIcon} class="text-emerald-400 text-sm"></iconify-icon>
                {card.footerLeft}
              </span>
              <span class="text-neutral-400 text-[10px]">{card.footerRight}</span>
            </div>

          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Botão de Ação Centralizado (Quadrado // Beam Glow) -->
  <div class="mt-8 flex justify-center">
    <Button
      rounded="rounded-none"
      variant="beam-glow"
      onclick={ctaAction}
      icon="solar:arrow-right-bold-duotone"
      iconPosition="right"
    >
      {ctaText}
    </Button>
  </div>
</div>
