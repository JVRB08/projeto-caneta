---
interface Props {
  variant?: 'primary' | 'secondary' | 'beam' | 'beam-glow' | 'tool' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  rounded?: string;
  id?: string;
  type?: 'button' | 'submit' | 'reset';
  href?: string;
  icon?: string;
  iconPosition?: 'left' | 'right';
  class?: string;
  onclick?: string;
  title?: string;
  target?: string;
  rel?: string;
  'aria-label'?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  rounded = 'rounded-none',
  id,
  type = 'button',
  href,
  icon,
  iconPosition = 'right',
  class: className = '',
  onclick,
  title,
  target,
  rel,
  'aria-label': ariaLabel,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const tagProps = href
  ? { href, target, rel, id, title, 'aria-label': ariaLabel, onclick, ...rest }
  : { type, id, title, 'aria-label': ariaLabel, onclick, ...rest };
---

{variant === 'beam' ? (
  <Tag
    {...tagProps}
    class:list={[
      "btn-beam px-[1px] py-[1px] group cursor-pointer shrink-0 shadow-none inline-block",
      rounded,
      className
    ]}
  >
    <div class:list={[
      "btn-beam-content px-7 py-3 bg-stone-900 group-hover:bg-stone-800 text-xs font-mono uppercase tracking-widest text-white transition-all flex items-center justify-center gap-2",
      rounded
    ]}>
      {icon && iconPosition === 'left' && (
        <iconify-icon icon={icon} class="text-sm"></iconify-icon>
      )}
      <span><slot /></span>
      {icon && iconPosition === 'right' && (
        <iconify-icon icon={icon} class="text-sm group-hover:translate-x-1 transition-transform"></iconify-icon>
      )}
    </div>
  </Tag>
) : variant === 'beam-glow' ? (
  <div class:list={["group relative scale-100 hover:scale-105 transition-transform duration-300 shrink-0 inline-block", className]}>
    <Tag
      {...tagProps}
      class:list={[
        "relative z-10 flex items-center justify-center overflow-hidden p-[1.5px] leading-none cursor-pointer shadow-none",
        rounded
      ]}
    >
      <span class="absolute inset-[-1000%] animate-[spin_2.5s_linear_infinite] bg-[conic-gradient(from_0deg,transparent_0_320deg,rgba(255,255,255,0.7)_340deg,#ffffff_360deg)]"></span>
      <span class:list={[
        "relative flex h-full w-full items-center bg-neutral-950 px-7 py-3 ring-1 ring-white/20 transition-colors group-hover:bg-neutral-900",
        rounded
      ]}>
        <span class="relative z-10 flex items-center gap-2">
          {icon && iconPosition === 'left' && (
            <iconify-icon icon={icon} class="text-sm text-white"></iconify-icon>
          )}
          <span class="text-xs font-mono uppercase tracking-widest text-white font-medium"><slot /></span>
          {icon && iconPosition === 'right' && (
            <iconify-icon icon={icon} class="text-sm text-white group-hover:translate-x-1 transition-transform"></iconify-icon>
          )}
        </span>
      </span>
    </Tag>
  </div>
) : variant === 'secondary' ? (
  <Tag
    {...tagProps}
    class:list={[
      "bg-white/80 border border-stone-300 text-stone-900 font-mono text-xs uppercase tracking-widest flex items-center justify-center gap-2 hover:bg-white hover:border-stone-400 transition-all cursor-pointer group shadow-none",
      rounded,
      size === 'sm' ? "px-5 py-2" : "px-7 py-3",
      className
    ]}
  >
    {icon && iconPosition === 'left' && (
      <iconify-icon icon={icon} class="text-xs"></iconify-icon>
    )}
    <span><slot /></span>
    {icon && iconPosition === 'right' && (
      <iconify-icon icon={icon} class="text-xs group-hover:translate-y-0.5 transition-transform"></iconify-icon>
    )}
  </Tag>
) : variant === 'tool' ? (
  <Tag
    {...tagProps}
    class:list={[
      "px-2.5 py-1.5 border border-stone-300 text-[10px] font-mono uppercase text-stone-700 bg-stone-100 hover:bg-stone-200 hover:text-stone-900 transition-colors flex items-center gap-1 cursor-pointer shadow-none",
      rounded,
      className
    ]}
  >
    {icon && (
      <iconify-icon icon={icon}></iconify-icon>
    )}
    <span><slot /></span>
  </Tag>
) : variant === 'ghost' ? (
  <Tag
    {...tagProps}
    class:list={[
      "text-stone-400 hover:text-stone-900 transition-colors p-1 cursor-pointer shadow-none",
      rounded,
      className
    ]}
  >
    {icon && (
      <iconify-icon icon={icon} class="text-2xl"></iconify-icon>
    )}
    <slot />
  </Tag>
) : (
  <Tag
    {...tagProps}
    class:list={[
      "bg-stone-900 text-white font-mono text-xs uppercase tracking-widest flex items-center justify-center gap-2 hover:bg-stone-800 transition-all cursor-pointer group shadow-none",
      rounded,
      size === 'sm' ? "px-5 py-2" : "px-7 py-3",
      className
    ]}
  >
    {icon && iconPosition === 'left' && (
      <iconify-icon icon={icon} class="text-xs"></iconify-icon>
    )}
    <span><slot /></span>
    {icon && iconPosition === 'right' && (
      <iconify-icon icon={icon} class="text-xs group-hover:translate-x-1 transition-transform"></iconify-icon>
    )}
  </Tag>
)}
