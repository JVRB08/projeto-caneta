---
interface Props {
  brandName?: string;
}

const {
  brandName = "ARTOOLS"
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isInicio = pathname === '/';
const isCatalogo = pathname.startsWith('/pagina2') || pathname.startsWith('/segunda-pagina');
const isProduto = pathname.startsWith('/produto') || pathname.startsWith('/pagina3');
---

<!-- Cabeçalho Minimalista ARTOOLS -->
<header
  class="fixed top-0 left-0 w-full z-50 border-b border-stone-200/80 bg-white/80 backdrop-blur-md transition-transform duration-500"
  id="navbar"
>
  <div class="max-w-[1440px] mx-auto flex justify-between items-center px-6 md:px-12 py-4">
    
    <!-- 1. Logo Minimalista: Apenas Ícone e Nome -->
    <a href="/" class="flex items-center gap-2.5 group cursor-pointer" aria-label={`${brandName} Início`}>
      <iconify-icon icon="solar:pen-bold" class="text-xl text-stone-900 group-hover:rotate-12 transition-transform duration-300"></iconify-icon>
      <span class="font-display font-bold tracking-tight text-lg text-stone-900">{brandName}</span>
    </a>

    <!-- 2. Links com Indicador Visual da Página Atual (Sem Carrinho) -->
    <nav class="flex items-center gap-6 sm:gap-8 text-xs font-mono uppercase tracking-widest">
      <a
        href="/"
        class:list={[
          "transition-all py-1 relative",
          isInicio
            ? "text-stone-950 font-bold border-b-2 border-stone-900"
            : "text-stone-400 hover:text-stone-900"
        ]}
      >
        INÍCIO
      </a>

      <a
        href="/pagina2"
        class:list={[
          "transition-all py-1 relative",
          isCatalogo
            ? "text-stone-950 font-bold border-b-2 border-stone-900"
            : "text-stone-400 hover:text-stone-900"
        ]}
      >
        CATÁLOGO
      </a>

      <a
        href="/produto"
        class:list={[
          "transition-all py-1 relative",
          isProduto
            ? "text-stone-950 font-bold border-b-2 border-stone-900"
            : "text-stone-400 hover:text-stone-900"
        ]}
      >
        DETALHES DO PRODUTO
      </a>
    </nav>

  </div>
</header>
